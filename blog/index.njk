---
layout: main
---

<p class="feed-link">
  <a href="/feed.xml">
    <svg
      class="feed-link__icon"
      viewBox="0 0 8 8"
      aria-hidden="true"
      focusable="false"
    >
      <rect fill="currentColor" width="8" height="8" rx="1.5" />
      <circle class="feed-link__symbol" cx="2" cy="6" r="1" />
      <path
        class="feed-link__symbol"
        d="m 1,4 a 3,3 0 0 1 3,3 h 1 a 4,4 0 0 0 -4,-4 z"
      />
      <path
        class="feed-link__symbol"
        d="m 1,2 a 5,5 0 0 1 5,5 h 1 a 6,6 0 0 0 -6,-6 z"
      />
    </svg>
    Subscribe via RSS
  </a>
</p>

{% for post in collections.blog | reverse %}
  <article>
    <header>
      <h1>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h1>
      {% if post.data.subtitle %}
        <div>{{ post.data.subtitle }}</div>
      {% endif %}
      <div class="date">
        Posted on {{ post.date | fullDate }} by
        <a href="/about">miseryconfusion</a>
      </div>
    </header>
    {{ post.templateContent | safe }}
  </article>
  {% if not loop.last %}<hr />{% endif %}
{% endfor %}
