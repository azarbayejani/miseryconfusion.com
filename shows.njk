---
layout: main
---

{% import 'components.njk' as components %}

<style>
  .shows {
    --show-border: #d0d7de;
    --show-muted: #666;
    --show-lineup: var(--show-muted);
    --show-accent: var(--link-color);
  }

  @media (prefers-color-scheme: dark) {
    .shows {
      --show-border: #30363d;
      --show-muted: #8b949e;
      --show-lineup: var(--show-muted);
      --show-accent: var(--link-color-dark);
    }

    .show-card_date {
      color: var(--background-dark);
    }
  }

  .showList,
  .show-archive {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .show-card {
    display: flex;
    margin-bottom: 1em;
    border: 1px solid var(--show-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .show-card_date {
    flex: 0 0 4.5em;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.4em 0;
    background: var(--show-accent);
    color: #fff;
    text-align: center;
    line-height: 1.15;
  }

  .show-card_weekday {
    font-size: 0.72em;
    font-weight: 400;
  }

  .show-card_day {
    font-size: 1em;
    font-weight: 700;
  }

  .show-card_body {
    flex: 1 1 auto;
    min-width: 0;
    padding: 14px 16px;
  }

  /* On narrow screens, put the date in a strip across the top of the card */
  @media (max-width: 540px) {
    .show-card {
      flex-direction: column;
    }

    .show-card_date {
      flex: 0 0 auto;
      flex-direction: row;
      justify-content: flex-start;
      align-items: baseline;
      gap: 0.25em;
      padding: 6px 16px;
    }

    .show-card_weekday {
      line-height: inherit;
      font-size: inherit;
      font-weight: 700;
    }

    .show-card_day {
      margin-top: 0;
    }

    .show-card_body {
      padding-top: 12px;
    }
  }

  .show-card_title {
    font-weight: 600;
    font-size: 1.1em;
    line-height: 1.25;
  }

  .show-card_lineup,
  .show-archive_lineup {
    color: var(--show-lineup);
    font-size: 0.875em;
    line-height: 1.3;
    margin-top: 0.5em;
    max-width: 75%;
  }

  /* Let long lineups use the full width where there's no room to spare */
  @media (max-width: 540px) {
    .show-card_lineup,
    .show-archive_lineup {
      max-width: none;
    }
  }

  .show-card_meta,
  .show-archive_meta {
    color: var(--show-muted);
    font-size: 0.875em;
    line-height: 1.25;
  }

  /* Space the metadata block away from the title/lineup block */
  .show-card_title + .show-card_meta,
  .show-card_lineup + .show-card_meta,
  .show-archive_title + .show-archive_meta,
  .show-archive_lineup + .show-archive_meta {
    margin-top: 0.35em;
  }

  .show-year {
    margin: 1.25em 0 0.25em;
  }

  .show-archive_row {
    display: grid;
    grid-template-columns: 4em 1fr;
    column-gap: 0.75em;
    padding: 0.4em 0;
  }

  .show-archive_date {
    color: var(--show-muted);
    font-size: 0.875em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 0.2em;
  }
</style>

<section class="shows">
  <h2>Upcoming dates:</h2>

  {% if shows.upcoming.length == 0 %}
    <p>There are no shows scheduled at the moment.</p>
  {% else %}
    {% for group in shows.upcomingByYear %}
      {% if not loop.first %}
        <h3 class="show-year">{{ group.year }}</h3>
      {% endif %}
      <ol class="showList">
        {% for show in group.shows %}
          <li class="show-card">
            <div class="show-card_date">
              <span class="show-card_weekday">{{ show.weekday }}</span>
              <span class="show-card_day">{{ show.monthDay }}</span>
            </div>
            <div class="show-card_body">
              {% if show.title == "TBA" %}
                <div class="show-card_title">
                  {{ show.location }} — venue TBA
                </div>
                <div class="show-card_meta">
                  {{ show.category }} · {{ show.artistName }}
                </div>
              {% else %}
                <div class="show-card_title">
                  {% if show.link %}
                    <a href="{{ show.link }}">{{ show.title }}</a>
                  {% else %}
                    {{ show.title }}
                  {% endif %}
                </div>
                {% if show.lineup %}
                  <div class="show-card_lineup">{{ show.lineup }}</div>
                {% endif %}

                <div class="show-card_meta">
                  {% if show.venue and show.venue != "TBA" %}{{ show.venue }} ·{% endif %}
                  {{ show.location }}
                </div>
                <div class="show-card_meta">
                  {{ show.category }} · {{ show.artistName }}
                </div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endfor %}
  {% endif %}

  <h2>Past dates:</h2>

  {% for group in shows.pastByYear %}
    <h3 class="show-year">{{ group.year }}</h3>
    <ol class="show-archive">
      {% for show in group.shows %}
        <li class="show-archive_row">
          <span class="show-archive_date">{{ show.shortDate }}</span>
          <div>
            <div class="show-archive_title">
              {% if show.link %}
                <a href="{{ show.link }}">{{ show.title }}</a>
              {% else %}
                {{ show.title }}
              {% endif %}
            </div>
            {% if show.lineup %}
              <div class="show-archive_lineup">{{ show.lineup }}</div>
            {% endif %}

            <div class="show-archive_meta">
              {% if show.venue %}{{ show.venue }} ·{% endif %}
              {{ show.location }}
            </div>
            <div class="show-archive_meta">
              {{ show.category }} · {{ show.artistName }}
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endfor %}

  <p>
    I did my best to remember every show I've ever played. If you remember one
    that's missing, let me know!
  </p>
</section>

<section>
  <h2>Coldbrew Collective</h2>
  <p>
    I also did live visuals as one half of Coldbrew Collective, a duo with
    Aashish Gadani.
  </p>
  <p>
    You can find the full list of all our shows and installs on
    <a href="https://aashishgadani.com/cc_show_list.html">Aashish's website</a>.
  </p>
</section>
