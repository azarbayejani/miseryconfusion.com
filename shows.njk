---
layout: main
---

{% import 'components.njk' as components %}

<style>
  .shows {
    --show-border: #d0d7de;
    --show-muted: #666;
    --show-accent: var(--link-color);
  }

  @media (prefers-color-scheme: dark) {
    .shows {
      --show-border: #30363d;
      --show-muted: #8b949e;
      --show-accent: var(--link-color-dark);
    }

    .show-card_date {
      color: var(--background-dark);
    }
  }

  .showList,
  .show-archive {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .show-card {
    display: flex;
    margin-bottom: 1em;
    border: 1px solid var(--show-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .show-card_date {
    flex: 0 0 4.5em;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 14px 8px;
    background: var(--show-accent);
    color: #fff;
    text-align: center;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .show-card_weekday {
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: 0.08em;
    /* Match the title's line box so the two sit on the same line */
    line-height: calc(1.1rem * 1.25);
  }

  .show-card_day {
    font-size: 1em;
    font-weight: 700;
    margin-top: 0.1em;
  }

  .show-card_year {
    font-size: 0.7em;
    opacity: 0.85;
  }

  .show-card_body {
    flex: 1 1 auto;
    min-width: 0;
    padding: 14px 16px;
  }

  /* On narrow screens, put the date in a strip across the top of the card */
  @media (max-width: 540px) {
    .show-card {
      flex-direction: column;
    }

    .show-card_date {
      flex: 0 0 auto;
      flex-direction: row;
      justify-content: flex-start;
      align-items: baseline;
      gap: 0.5em;
      padding: 6px 16px;
    }

    .show-card_weekday {
      line-height: inherit;
    }

    .show-card_day {
      margin-top: 0;
    }

    .show-card_body {
      padding-top: 12px;
    }
  }

  .show-card_title {
    font-weight: 600;
    font-size: 1.1em;
    line-height: 1.25;
  }

  .show-card_meta,
  .show-archive_meta {
    color: var(--show-muted);
    font-size: 0.875em;
    line-height: 1.25;
  }

  .show-year {
    margin: 1.25em 0 0.25em;
  }

  .show-archive_row {
    display: grid;
    grid-template-columns: 4em 1fr;
    column-gap: 0.75em;
    padding: 0.4em 0;
  }

  .show-archive_date {
    color: var(--show-muted);
    font-size: 0.875em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 0.2em;
  }
</style>

<section class="shows">
  <h2>Upcoming dates:</h2>

  {% if shows.upcoming.length == 0 %}
    <p>There are no shows scheduled at the moment.</p>
  {% else %}
    <ol class="showList">
      {% for show in shows.upcoming %}
        <li class="show-card">
          <div class="show-card_date">
            <span class="show-card_weekday">{{ show.weekday }}</span>
            <span class="show-card_day">{{ show.monthDay }}</span>
            {% if shows.upcomingSpansYears %}
              <span class="show-card_year">{{ show.year }}</span>
            {% endif %}
          </div>
          <div class="show-card_body">
            {% if show.title == "TBA" %}
              <div class="show-card_title">{{ show.location }} — venue TBA</div>
              <div class="show-card_meta">
                {{ show.category }} · {{ show.artistName }}
              </div>
            {% else %}
              <div class="show-card_title">
                {% if show.link %}
                  <a href="{{ show.link }}">{{ show.title }}</a>
                {% else %}
                  {{ show.title }}
                {% endif %}
              </div>
              <div class="show-card_meta">
                {{ show.category }} · {{ show.artistName }}
              </div>
              <div class="show-card_meta">
                {% if show.venue and show.venue != "TBA" %}{{ show.venue }} ·{% endif %} {{ show.location }}
              </div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}

  <h2>Past dates:</h2>

  {% for group in shows.pastByYear %}
    <h3 class="show-year">{{ group.year }}</h3>
    <ol class="show-archive">
      {% for show in group.shows %}
        <li class="show-archive_row">
          <span class="show-archive_date">{{ show.shortDate }}</span>
          <div>
            <div class="show-archive_title">
              {% if show.link %}
                <a href="{{ show.link }}">{{ show.title }}</a>
              {% else %}
                {{ show.title }}
              {% endif %}
            </div>

            <div class="show-archive_meta">
              {{ show.category }} · {{ show.artistName }}
            </div>
            <div class="show-archive_meta">
              {% if show.venue %}{{ show.venue }} ·{% endif %} {{ show.location }}
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endfor %}

  <p>
    I did my best to remember every show I've ever played. If you remember one
    that's missing, let me know!
  </p>
</section>

<section>
  <h2>Coldbrew Collective</h2>
  <p>
    I also did live visuals as one half of Coldbrew Collective, a duo with
    Aashish Gadani.
  </p>
  <p>
    You can find the full list of all our shows and installs on
    <a href="https://aashishgadani.com/cc_show_list.html">Aashish's website</a>.
  </p>
</section>
