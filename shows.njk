---
layout: main
---

{% import 'components.njk' as components %}

<style>
  .shows {
    --show-border: #d0d7de;
    --show-muted: #666;
    --show-accent: var(--link-color);
  }

  @media (prefers-color-scheme: dark) {
    .shows {
      --show-border: #30363d;
      --show-muted: #8b949e;
      --show-accent: var(--link-color-dark);
    }
  }

  .showList,
  .show-archive {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .show-card {
    margin-bottom: 1em;
    border: 1px solid var(--show-border);
    border-left: 4px solid var(--show-accent);
    padding: 14px 16px;
    border-radius: 12px;
  }

  .show-card_title {
    font-weight: 600;
    font-size: 1.1em;
  }

  .show-card_meta,
  .show-archive_meta {
    color: var(--show-muted);
    font-size: 0.875em;
  }

  .show-card_tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-top: 0.6em;
  }

  .show_tag {
    font-size: 0.75em;
    padding: 0.1em 0.7em;
    border: 1px solid var(--show-border);
    border-radius: 999px;
    color: var(--show-muted);
  }

  .show-year {
    margin: 1.25em 0 0.25em;
  }

  .show-archive_row {
    display: grid;
    grid-template-columns: 4em 1fr;
    column-gap: 0.75em;
    padding: 0.4em 0;
  }

  .show-archive_date {
    color: var(--show-muted);
    font-size: 0.875em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 0.2em;
  }
</style>

<section class="shows">
  <h2>Upcoming dates:</h2>

  {% if shows.upcoming.length == 0 %}
    <p>There are no shows scheduled at the moment.</p>
  {% else %}
    <ol class="showList">
      {% for show in shows.upcoming %}
        <li class="show-card">
          {% if show.title == "TBA" %}
            <div class="show-card_title">{{ show.location }} — venue TBA</div>
            <div class="show-card_meta">{{ show.humanDate }}</div>
          {% else %}
            <div class="show-card_title">
              {% if show.link %}
                <a href="{{ show.link }}">{{ show.title }}</a>
              {% else %}
                {{ show.title }}
              {% endif %}
            </div>
            <div class="show-card_meta">
              {{ show.humanDate }}{% if show.venue and show.venue != "TBA" %}
                · {{ show.venue }}{% endif %}
              · {{ show.location }}
            </div>
          {% endif %}
          <div class="show-card_tags">
            <span class="show_tag">{{ show.category }}</span>
            <span class="show_tag">{{ show.artistName }}</span>
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}

  <h2>Past dates:</h2>

  {% for group in shows.pastByYear %}
    <h3 class="show-year">{{ group.year }}</h3>
    <ol class="show-archive">
      {% for show in group.shows %}
        <li class="show-archive_row">
          <span class="show-archive_date">{{ show.shortDate }}</span>
          <div>
            <div class="show-archive_title">
              {% if show.link %}
                <a href="{{ show.link }}">{{ show.title }}</a>
              {% else %}
                {{ show.title }}
              {% endif %}
            </div>
            <div class="show-archive_meta">
              {% if show.venue %}{{ show.venue }} · {% endif %}{{ show.location }}
              · {{ show.category }} · {{ show.artistName }}
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endfor %}

  <p>
    I did my best to remember every show I've ever played. If you remember one
    that's missing, let me know!
  </p>
</section>

<section>
  <h2>Coldbrew Collective</h2>
  <p>
    I also did live visuals as one half of Coldbrew Collective, a duo with
    Aashish Gadani.
  </p>
  <p>
    You can find the full list of all our shows and installs on
    <a href="https://aashishgadani.com/cc_show_list.html">Aashish's website</a>.
  </p>
</section>
