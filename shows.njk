---
layout: main
---

{% import 'components.njk' as components %}

{% macro showLinks(show, class) %}
  {% if show.link or show.poster %}
    <div class="{{ class }}">
      {% if show.link %}
        <a href="{{ show.link }}"
          >Event page <span aria-hidden="true">↗</span></a
        >
      {% endif %}
      {% if show.poster %}
        <a href="{{ show.poster }}" data-poster-title="{{ show.title }}"
          >Poster <span aria-hidden="true">↗</span></a
        >
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}

<style>
  .shows {
    --show-border: #d0d7de;
    --show-muted: #666;
    --show-lineup: var(--show-muted);
    --show-accent: var(--link-color);
  }

  .showList,
  .show-archive {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .show-card {
    display: flex;
    margin-bottom: 1em;
    border: 1px solid var(--show-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .show-card_date {
    flex: 0 0 4.5em;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.4em 0;
    background: var(--show-accent);
    color: var(--background-light);
    text-align: center;
    line-height: 1.15;
  }

  .show-card_weekday {
    font-size: 0.72em;
    font-weight: 400;
  }

  .show-card_day {
    font-size: 1em;
    font-weight: 700;
  }

  .show-card_body {
    flex: 1 1 auto;
    min-width: 0;
    padding: 14px 16px;
  }

  /* On narrow screens, put the date in a strip across the top of the card */
  @media (max-width: 540px) {
    .show-card {
      flex-direction: column;
    }

    .show-card_date {
      flex: 0 0 auto;
      flex-direction: row;
      justify-content: flex-start;
      align-items: baseline;
      gap: 0.25em;
      padding: 6px 16px;
    }

    .show-card_weekday {
      line-height: inherit;
      font-size: inherit;
      font-weight: 700;
    }

    .show-card_day {
      margin-top: 0;
    }

    .show-card_body {
      padding-top: 12px;
    }
  }

  .show-card_title {
    font-weight: 600;
    font-size: 1.1em;
    line-height: 1.25;
  }

  .show-card_lineup,
  .show-archive_lineup {
    color: var(--show-lineup);
    font-size: 0.875em;
    line-height: 1.3;
    margin-top: 0.5em;
    max-width: 75%;
  }

  /* Let long lineups use the full width where there's no room to spare */
  @media (max-width: 540px) {
    .show-card_lineup,
    .show-archive_lineup {
      max-width: none;
    }
  }

  .show-card_meta,
  .show-archive_meta {
    color: var(--show-muted);
    font-size: 0.875em;
    line-height: 1.25;
  }

  /* Space the metadata block away from the title/lineup block */
  .show-card_title + .show-card_meta,
  .show-card_lineup + .show-card_meta,
  .show-archive_title + .show-archive_meta,
  .show-archive_lineup + .show-archive_meta {
    margin-top: 0.35em;
  }

  .show-card_links,
  .show-archive_links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1em;
    font-size: 0.875em;
    line-height: 1.25;
    margin-top: 0.6em;
  }

  .show-archive_links {
    margin-top: 0.35em;
  }

  .show-year {
    margin: 1.25em 0 0.25em;
  }

  /* Poster lightbox */
  .poster-lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: none;
    max-height: none;
  }

  .poster-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  .poster-lightbox_figure {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .poster-lightbox_img {
    display: block;
    align-self: center;
    width: auto;
    height: auto;
    max-width: min(92vw, 720px);
    max-height: 80vh;
  }

  .poster-lightbox_caption {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    margin-top: 0.5em;
    color: #fff;
    font-size: 0.875em;
  }

  .poster-lightbox_caption a {
    color: #fff;
  }

  /* Sits in its own row above the image, never covering the poster */
  .poster-lightbox_close {
    align-self: flex-end;
    margin-bottom: 0.5em;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    font-size: 0.875em;
    text-decoration: underline;
    text-underline-offset: 0.1em;
    cursor: pointer;
  }

  .poster-lightbox_close:hover,
  .poster-lightbox_close:focus-visible {
    text-decoration-thickness: 2px;
  }

  .show-archive_row {
    display: grid;
    grid-template-columns: 4em 1fr;
    column-gap: 0.75em;
    padding: 0.4em 0;
  }

  .show-archive_date {
    color: var(--show-muted);
    font-size: 0.875em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 0.2em;
  }

  @media (prefers-color-scheme: dark) {
    .shows {
      --show-border: #30363d;
      --show-muted: #8b949e;
      --show-lineup: var(--show-muted);
      --show-accent: var(--link-color-dark);
    }

    .show-card_date {
      color: var(--background-dark);
    }
  }
</style>

<section class="shows">
  <h2>Upcoming dates:</h2>

  {% if shows.upcoming.length == 0 %}
    <p>There are no shows scheduled at the moment.</p>
  {% else %}
    {% for group in shows.upcomingByYear %}
      {% if not loop.first %}
        <h3 class="show-year">{{ group.year }}</h3>
      {% endif %}
      <ol class="showList">
        {% for show in group.shows %}
          <li class="show-card">
            <div class="show-card_date">
              <span class="show-card_weekday">{{ show.weekday }}</span>
              <span class="show-card_day">{{ show.monthDay }}</span>
            </div>
            <div class="show-card_body">
              {% if show.title == "TBA" %}
                <div class="show-card_title">
                  {{ show.location }} — venue TBA
                </div>
                <div class="show-card_meta">
                  {{ show.category }} · {{ show.artistName }}
                </div>
              {% else %}
                <div class="show-card_title">{{ show.title }}</div>
                {% if show.lineup %}
                  <div class="show-card_lineup">{{ show.lineup }}</div>
                {% endif %}

                <div class="show-card_meta">
                  {% if show.venue and show.venue != "TBA" %}{{ show.venue }} ·{% endif %}
                  {{ show.location }}
                </div>
                <div class="show-card_meta">
                  {{ show.category }} · {{ show.artistName }}
                </div>
                {{ showLinks(show, "show-card_links") }}
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endfor %}
  {% endif %}

  <h2>Past dates:</h2>

  {% for group in shows.pastByYear %}
    <h3 class="show-year">{{ group.year }}</h3>
    <ol class="show-archive">
      {% for show in group.shows %}
        <li class="show-archive_row">
          <span class="show-archive_date">{{ show.shortDate }}</span>
          <div>
            <div class="show-archive_title">{{ show.title }}</div>
            {% if show.lineup %}
              <div class="show-archive_lineup">{{ show.lineup }}</div>
            {% endif %}

            <div class="show-archive_meta">
              {% if show.venue %}{{ show.venue }} ·{% endif %}
              {{ show.location }}
            </div>
            <div class="show-archive_meta">
              {{ show.category }} · {{ show.artistName }}
            </div>
            {{ showLinks(show, "show-archive_links") }}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endfor %}

  <p>
    I did my best to remember every show I've ever played. If you remember one
    that's missing, let me know!
  </p>

  <dialog class="poster-lightbox" aria-label="Show poster">
    <figure class="poster-lightbox_figure">
      <button class="poster-lightbox_close" type="button" autofocus>
        Close
      </button>
      <img class="poster-lightbox_img" alt="" />
      <figcaption class="poster-lightbox_caption">
        <span class="poster-lightbox_title"></span>
        <a class="poster-lightbox_full" href="#"
          >Open full size <span aria-hidden="true">↗</span></a
        >
      </figcaption>
    </figure>
  </dialog>
</section>

<script>
  (() => {
    const dialog = document.querySelector(".poster-lightbox");
    if (!dialog || typeof dialog.showModal !== "function") return;

    const img = dialog.querySelector(".poster-lightbox_img");
    const title = dialog.querySelector(".poster-lightbox_title");
    const full = dialog.querySelector(".poster-lightbox_full");
    const close = dialog.querySelector(".poster-lightbox_close");

    for (const link of document.querySelectorAll("a[data-poster-title]")) {
      link.addEventListener("click", (event) => {
        // Leave modified clicks alone so "open in new tab" still works
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();

        const name = link.dataset.posterTitle;
        img.src = link.href;
        img.alt = `Poster for ${name}`;
        title.textContent = name;
        full.href = link.href;
        dialog.showModal();
      });
    }

    close.addEventListener("click", () => dialog.close());

    // Clicks on the backdrop land on the dialog itself
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => {
      img.removeAttribute("src");
    });
  })();
</script>

<section>
  <h2>Coldbrew Collective</h2>
  <p>
    I also did live visuals as one half of Coldbrew Collective, a duo with
    Aashish Gadani.
  </p>
  <p>
    You can find the full list of all our shows and installs on
    <a href="https://aashishgadani.com/cc_show_list.html">Aashish's website</a>.
  </p>
</section>
